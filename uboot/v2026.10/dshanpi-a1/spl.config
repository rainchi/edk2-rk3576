# Merged over dshanpi-a1-rk3576_defconfig by scripts/build-spl.sh.
# The defconfig is the TaishanPi 3M's (Armbian's, patch/u-boot/v2026.10 in
# armbian/build) with this board's device tree and without the LED driver.
# rk3576-100ask-dshanpi-a1.dts is the mainline Linux file, the same as
# devicetree/mainline/; U-Boot v2026.10's dts/upstream copy lacks one
# pinctrl-names line on &uart0.
CONFIG_LOCALVERSION="-edk2-rk3576"
# CONFIG_LOCALVERSION_AUTO is not set
# Must stay off: the FIT's EDK2 image is stored uncompressed.
# CONFIG_SPL_GZIP is not set
